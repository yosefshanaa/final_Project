# Negotiated contract vs. team uoh-sqak (CipherChase) - see docs/interop_uoh-sqak.md.
# Every term here is negotiated per opponent, so it lives in the environment and
# never in the committed constitution: an edit there would ride into the next match.
#
#   fish:  for l in (grep -v '^#' config/opponents/uoh-sqak.env); set -x (string split -m1 = $l); end
#   bash:  set -a; . config/opponents/uoh-sqak.env; set +a

# -- wire contract (their brief, confirmed) ----------------------------------
P2P_DIALECT=reference
P2P_ALTERNATE_ROLES=true
P2P_HANDSHAKE_PER_SUB_GAME=true

# Their thief announces enclosure itself (rules 46/47), so our cop must not also
# claim it - two mechanisms reporting one event. The opposite of our default.
P2P_CLAIM_ENCLOSURE=false

# -- negotiated terms (must be VALUE-EQUAL: their verify_peer compares by dict equality)
P2P_MAP_AREA=7x7
P2P_AXIS_ORIGIN_CORNER=top_left
P2P_MIN_CENTER_INTENSITY=0.001
# Only if they hold at 30; the book caps a hint at 15 and we asked them for 15.
P2P_HINT_MAX_WORDS=30

# -- match day ---------------------------------------------------------------
# P2P_OPPONENT_URL=https://THEIR-TUNNEL/mcp
