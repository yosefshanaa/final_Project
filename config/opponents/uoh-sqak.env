# Negotiated contract vs. team uoh-sqak (CipherChase) - see docs/interop_uoh-sqak.md.
# Terms are negotiated per opponent, so they live here and never in the committed
# constitution: an edit there would ride into the next match.
#
#   fish:  for l in (grep -v '^#' config/opponents/uoh-sqak.env); set -x (string split -m1 = $l); end
#   bash:  set -a; . config/opponents/uoh-sqak.env; set +a

# -- wire contract (their brief, confirmed) ----------------------------------
P2P_DIALECT=reference
P2P_ALTERNATE_ROLES=true
P2P_HANDSHAKE_PER_SUB_GAME=true

# Their thief announces enclosure itself (rules 46/47), so our cop must not also
# claim it - two mechanisms reporting one event. The opposite of our default.
P2P_CLAIM_ENCLOSURE=false

# -- NO TERM OVERRIDES ------------------------------------------------------
# Their 2026-08-09 correction: the four terms their brief published
# (min_center_intensity 0.001, setting "7x7", hint_max_words 30,
# axis_origin_corner "top_left") were stale DOCUMENTATION. The values they
# actually send are 0.5 / "New York" / 15 / "top-left" - our committed
# constitution, unchanged, on all four. Adopting the published ones would have
# failed the handshake on every term, since their verify_peer compares by exact
# dict equality. So: override nothing here. Our defaults already match the wire.

# -- scent model -------------------------------------------------------------
# The one place we DO move: the registered multiplicative_book_v3 (no rounding,
# no dust floor, decay and emission in one pinned expression, field served AFTER
# the update so the freshest cell reads 0.9 rather than 0.81).
P2P_SCENT_MODEL=registered_v3

# -- match day ---------------------------------------------------------------
# P2P_OPPONENT_URL=https://THEIR-TUNNEL/mcp
