# Negotiated contract vs. team `<THEIR-SLUG>` - copy to config/opponents/<slug>.env
#
#   cp config/opponents/TEMPLATE.env config/opponents/<slug>.env
#   scripts/play.sh <slug> https://their-tunnel.example/mcp
#
#   bash/zsh: set -a; . config/opponents/<slug>.env; set +a
#   fish:     for l in (grep -v '^#' config/opponents/<slug>.env); set -x (string split -m1 = $l); end
#
# Every value below is a term the book leaves to each PAIR of teams. Answers come
# from the OPPONENT_BRIEF reply (docs/OPPONENT_BRIEF.md §2). The consequence of
# guessing wrong is written next to each one - all of them void a series, and a
# counted series cannot be replayed (one counted game per opponent, book §9.2.1).

# -- wire contract -----------------------------------------------------------
# Which MCP tool surface their peer exposes. `native` = our four-phase
# request-response set; `reference` = the course repo's push-and-inbox set.
# TRUST THE PROBE, NOT THEIR ANSWER:
#     PYTHONPATH=src .venv/bin/p2p-pursuit smoke https://their-url/mcp
# Wrong dialect = neither side can verify the other's commits at all.
P2P_DIALECT=reference

# Brief Q2. Reference-derived peers alternate (natural role on sub-games 1/3/5,
# opposite on 2/4/6). Wrong = both peers think they are the same role and the
# series deadlocks at sub-game 2.
P2P_ALTERNATE_ROLES=true

# Brief Q3. Reference-derived peers renegotiate before every sub-game. Wrong =
# their fresh handshake arrives as an unexpected message and the series drops.
P2P_HANDSHAKE_PER_SUB_GAME=true

# Brief Q4 (book §3.4). TRUE only if BOTH runtimes evaluate the enclosure rule.
# If their thief answers it themselves, ours must NOT also claim it - two
# mechanisms reporting one event desynchronises the score.
P2P_CLAIM_ENCLOSURE=false

# -- optional, only if they ask for them -------------------------------------
# Their capture claim is protocol-level and cannot be suppressed.
#P2P_ALWAYS_CLAIM=true
# Sign the full series length even when playing a shorter run.
#P2P_SIGNED_NUM_GAMES=6
# Exchange and confirm a series consensus document at the end.
#P2P_SERIES_CONSENSUS=true
# A mutually agreed game_id label, replacing the derived "<lo>-vs-<hi>".
#P2P_GAME_ID=

# -- pheromone physics (book rule #23) ---------------------------------------
# Must be byte-agreed before the first move. `book_v1` is the brief's default.
P2P_SCENT_MODEL=book_v1
# Our own tuning for this opponent - never a negotiated term, ours alone.
P2P_DOCTRINE=config/doctrine.json

# -- reporting ---------------------------------------------------------------
# KEEP `draft` FOR EVERY WARM-UP. The committed default is mode=send to
# rmisegal+uoh26finalgame@gmail.com (config/<role>/game.toml:38), so an
# uncounted run with this line removed mails the lecturer a warm-up report,
# which cannot be unsent. scripts/play.sh refuses that combination outright.
# Remove this line ONLY for the counted match.
P2P_EMAIL_MODE=draft
# Set only for a friendly whose report goes to the opponent instead.
#P2P_EMAIL_RECIPIENT=

# -- terms that are NOT env vars ---------------------------------------------
# The 14 constitution values (board size, start cells, move budget, barrier
# quota, scoring, sub-game count) live in config/<role>/game.json and are hashed
# into config_sha256; the handshake refuses to start on any mismatch. Ours is
#     3835f6a137620d8d98ab3925b2d1ed397d2d20d23bb9ba857bcd104284aac443
# If a team needs any of them changed, DO NOT edit config/<role>/game.json -
# that edit would ride into the next team's handshake. Build them a private
# directory instead, as done for amireman and orcai-mj:
#     mkdir -p config/opponents/<slug>/{police,thief}
#     cp config/police/game.* config/opponents/<slug>/police/
#     cp config/thief/game.*  config/opponents/<slug>/thief/
#     # edit those copies, then add to the launch:
#     scripts/play.sh <slug> <url> --config-dir config/opponents/<slug>/police
# Then re-send them the NEW hash - see docs/OPPONENT_BRIEF.md §3.
#
# Note also: P2P_MAP_AREA, P2P_HINT_MAX_WORDS, P2P_MIN_CENTER_INTENSITY and
# P2P_AXIS_ORIGIN_CORNER overlay the constitution *before* it is hashed, so
# setting any of them here changes config_sha256 too. Re-send the new hash.
